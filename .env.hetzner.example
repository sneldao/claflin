# ================================================
# Claflin - Hetzner VPS Configuration
# ================================================
# Copy this file to .env.hetzner and fill in your values
# cp .env.hetzner.example .env.hetzner
#
# Used by PM2 via ecosystem.config.js (loads .env.hetzner).
# deploy.sh reads secrets from environment variables and
# writes them to .env.hetzner so PM2 can pick them up.
# ================================================

# NOTE: The current client-facing product is the paper trading desk at `/`.
# It needs only NODE_ENV/PORT/HOSTNAME plus BASE_RPC_URL below. The remaining
# variables configure retained services (call billing, wallet, Redis-backed
# modules) — required only if those services are in use, not for the desk.

# ================================================
# Server Configuration
# ================================================
NODE_ENV=production
PORT=3042
HOSTNAME=0.0.0.0

# ================================================
# Base quote service (paper desk)
# ================================================
BASE_RPC_URL=https://mainnet.base.org
# BASE_RPC_FALLBACK_URL=https://your-second-provider.example

# ================================================
# Arbitrum Network Configuration
# ================================================
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Payment receiver wallet
PAYMENT_RECEIVER=0xYourWalletAddressHere

# ================================================
# Thirdweb Configuration (x402 payments)
# ================================================
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key

# ================================================
# WalletConnect Configuration
# ================================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ================================================
# Upstash Redis (production)
# ================================================
# Create a database at https://console.upstash.com and paste
# the REST URL and REST Token here. deploy.sh reads these from
# environment variables and writes them here on every deploy.
UPSTASH_REDIS_REST_URL=https://game-corgi-122374.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
UPSTASH_REDIS_URL=${UPSTASH_REDIS_REST_URL}
UPSTASH_REDIS_TOKEN=${UPSTASH_REDIS_REST_TOKEN}

# ================================================
# ElevenLabs Voice API
# ================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_DEFAULT_VOICE=Adam
ELEVENLABS_CONVERSATIONAL_ENABLED=true

# Hetty — the desk's live voice session (scripts/create-hetty-agent.mjs)
ELEVENLABS_AGENT_HETTY=

# Legacy marketplace agent IDs (retained service only; not used by the desk)
ELEVENLABS_AGENT_SOLANA_SAGE=
ELEVENLABS_AGENT_CODE_REVIEWER=
ELEVENLABS_AGENT_GENERAL_HELPER=
ELEVENLABS_AGENT_TOUR_MASTER=

# ================================================
# Payment Settlement
# ================================================
FACILITATOR_PRIVATE_KEY=0xYourPrivateKeyHere
NEXT_PUBLIC_PAYMENT_SETTLEMENT_ENABLED=true

# Platform wallet for ERC-8004 delegation
AGENT_WALLET=0xYourAgentWalletAddress
NEXT_PUBLIC_PLATFORM_ADDRESS=0x54351049081A5A64Ea93c56b666830ED5076b960

# ================================================
# ERC-8004 Agent Registry (Arbitrum Sepolia)
# ================================================
NEXT_PUBLIC_ERC8004_ENABLED=true
NEXT_PUBLIC_ERC8004_IDENTITY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
NEXT_PUBLIC_ERC8004_REPUTATION_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
NEXT_PUBLIC_ERC8004_DELEGATION_ADDRESS=0xb17A8dC3E37B9b95282cEA6594c1dFAa16026D00

# Agent tokenIds (after on-chain registration)
ERC8004_TOKEN_SOLANA_SAGE=
ERC8004_TOKEN_CODE_REVIEWER=
ERC8004_TOKEN_GENERAL_HELPER=
ERC8004_TOKEN_TOUR_MASTER=

# ================================================
# Composio Tool Integration
# ================================================
COMPOSIO_API_KEY=your_composio_api_key_here

# Webhook URL (your Hetzner server domain/IP)
NEXT_PUBLIC_WEBHOOK_URL=https://your-domain.com

# ================================================
# Feature Flags
# ================================================
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_PAYMENTS_ENABLED=true
NEXT_PUBLIC_RECORDING_ENABLED=true
NEXT_PUBLIC_X402_ENABLED=true

# ================================================
# Optional Services
# ================================================
# FIRECRAWL_API_KEY=your_firecrawl_api_key
# TAVILY_API_KEY=your_tavily_api_key

# ================================================
# Account tier (optional) — Privy login
# Desk works anonymously without these. When set,
# "Sign in" appears and sessions/records bind to the account.
# ================================================
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
