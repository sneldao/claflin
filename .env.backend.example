# ================================================
# Claflin - Backend-Only Config
# For Hetzner VPS / API Server
# ================================================
# This config is for the backend API server only.
# The frontend is deployed separately on Vercel.
# ================================================

# ================================================
# Server Configuration
# ================================================
NODE_ENV=production
PORT=3042
# Loopback only behind nginx in production.
HOSTNAME=127.0.0.1

# ================================================
# Arbitrum Network Configuration
# ================================================
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ================================================
# Redis Configuration (Required)
# ================================================
# Option 1: Upstash Redis (recommended - managed)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Aliases for compatibility
UPSTASH_REDIS_URL=${UPSTASH_REDIS_REST_URL}
UPSTASH_REDIS_TOKEN=${UPSTASH_REDIS_REST_TOKEN}

# ================================================
# ElevenLabs Voice API (Required for voice calls)
# Get from: https://elevenlabs.io/app/settings/api-keys
# ================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_DEFAULT_VOICE=Adam
ELEVENLABS_CONVERSATIONAL_ENABLED=true

# ================================================
# Thirdweb Configuration (for x402 payments)
# ================================================
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key

# ================================================
# Payment Settlement (Required for on-chain payments)
# ================================================
# Facilitator wallet private key (hot wallet - keep minimal funds)
FACILITATOR_PRIVATE_KEY=0xYourPrivateKeyHere

# Payment receiver address (cold wallet - main revenue)
PAYMENT_RECEIVER=0xYourPaymentReceiverAddress

# ================================================
# Composio Tool Integration
# ================================================
COMPOSIO_API_KEY=your_composio_api_key

# ================================================
# Webhook Configuration
# ================================================
# This is your Hetzner server URL (where webhooks are received)
NEXT_PUBLIC_WEBHOOK_URL=https://api.claflin.trustfall.xyz

# ================================================
# Feature Flags (Backend)
# ================================================
NEXT_PUBLIC_PAYMENT_SETTLEMENT_ENABLED=true
NEXT_PUBLIC_X402_ENABLED=true

# ================================================
# Optional Services
# ================================================
# FIRECRAWL_API_KEY=your_firecrawl_api_key
# TAVILY_API_KEY=your_tavily_api_key
