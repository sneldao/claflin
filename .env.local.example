# Claflin - Environment Variables
# Copy this file to .env.local and fill in your values
#
# ===============================================
# WHAT THE CURRENT PRODUCT ACTUALLY NEEDS
# ===============================================
# The client-facing product is the paper trading desk at `/`.
# It needs ONLY:
#   BASE_RPC_URL            - production RPC for Base (default: mainnet.base.org)
#   BASE_RPC_FALLBACK_URL   - optional second provider, rotated in after primary
#   NEXT_PUBLIC_APP_URL     - absolute site URL for metadata/OG tags
#
# EVERYTHING BELOW configures retained services (call billing, wallet,
# webhooks, marketplace remnants) that are not mounted by the paper desk
# and are not setup steps for it. Fill them in only if you are running
# those services.

# ===============================================
# Paper desk - Base quote service
# ===============================================
BASE_RPC_URL=https://mainnet.base.org
# BASE_RPC_FALLBACK_URL=https://your-second-provider.example
# NEXT_PUBLIC_APP_URL=https://your-claflin-app.vercel.app

# ===============================================
# Thirdweb Configuration (REQUIRED for x402 payments)
# Get your keys from: https://thirdweb.com/dashboard
# ===============================================
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id
THIRDWEB_SECRET_KEY=your_secret_key_for_x402

# ============================================
# Arbitrum Network (Arbitrum Sepolia Testnet)
# Chain ID: 421614 (testnet), 42161 (mainnet)
# ===============================================
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_ARBITRUM_CHAIN_ID=421614

# Payment receiver wallet (where payments go)
# Get testnet USDC from: https://faucet.circle.com/
PAYMENT_RECEIVER=0xYourWalletAddressHere

# Platform wallet for revenue split (20% platform fee)
# Payments are split: 80% to broker wallet, 20% to platform wallet
PLATFORM_WALLET=0xYourPlatformWalletAddress

# ===============================================
# WalletConnect (REQUIRED for wallet connection)
# Get your Project ID from: https://cloud.walletconnect.com
# ============================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ===============================================
# Upstash Redis (REQUIRED for production)
# Get credentials from: https://console.upstash.com
# ⚠️ WARNING: Missing credentials cause build warnings
# ============================================
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
UPSTASH_REDIS_URL=${UPSTASH_REDIS_REST_URL}
UPSTASH_REDIS_TOKEN=${UPSTASH_REDIS_REST_TOKEN}

# ===============================================
# x402 Payment Protocol (REQUIRED for micropayments)
# https://x402.org
# ===============================================
X402_FACILITATOR_URL=https://x402.facilitator.example.com
NEXT_PUBLIC_X402_ENABLED=true

# ===============================================
# Payment Settlement
# Users sign their own transactions - no facilitator needed
# ===============================================
NEXT_PUBLIC_PAYMENT_SETTLEMENT_ENABLED=true

# ===============================================
# Admin Access
# Comma-separated wallet addresses allowed to access /admin
# ===============================================
NEXT_PUBLIC_ADMIN_WALLETS=0xYourWalletAddressHere

# ===============================================
# Broker Notifications
# Webhook URL for broker approve/reject notifications
# ===============================================
BROKER_NOTIFICATION_WEBHOOK_URL=

# ===============================================
# ElevenLabs Voice API (REQUIRED for real TTS)
# Get your API key from: https://elevenlabs.io/api
# ===========================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_DEFAULT_VOICE=Adam

# ===============================================
# Claflin Broker Wallet (for revenue split payouts)
# ===============================================
BROKER_WALLET=0xYourBrokerWalletAddress

# ===============================================
# ERC-8004 Broker Registry (Arbitrum Sepolia - chain ID 421614)
# Contracts deployed - users sign their own transactions
# ============================================
NEXT_PUBLIC_ERC8004_ENABLED=true
NEXT_PUBLIC_ERC8004_IDENTITY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
NEXT_PUBLIC_ERC8004_REPUTATION_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
NEXT_PUBLIC_ERC8004_DELEGATION_ADDRESS=0xb17A8dC3E37B9b95282cEA6594c1dFAa16026D00

# =============================================
# Feature Flags (SET TO FALSE FOR PRODUCTION)
# ============================================
# DEMO_MODE bypasses all delegation auth - SET TO FALSE FOR PRODUCTION
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_PAYMENTS_ENABLED=true
NEXT_PUBLIC_RECORDING_ENABLED=true

# ==============================================
# ElevenLabs Conversational AI (REQUIRED for voice brokers)
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
# ==============================================
ELEVENLABS_CONVERSATIONAL_ENABLED=true

# ===============================================
# Composio Tool Integration (REQUIRED for broker tools)
# Get your API key from: https://composio.dev
# ==============================================
COMPOSIO_API_KEY=your_composio_api_key_here

# Webhook URL for tool callbacks (set to your production domain)
NEXT_PUBLIC_WEBHOOK_URL=https://your-app.vercel.app

# ===============================================
# ElevenLabs Webhook Authentication (REQUIRED in production)
# Set this to a random secret string and configure the same value in your
# ElevenLabs webhook settings as the X-ElevenLabs-Secret header.
# In production, webhooks are REJECTED when this is not set.
# ===============================================
ELEVENLABS_WEBHOOK_SECRET=your_webhook_secret_here

# ===============================================
# Claflin ElevenLabs Conversational AI Broker IDs
# Run `npx tsx scripts/seed-elevenlabs.ts` to generate these.
# ===============================================
ELEVENLABS_AGENT_HETTY=
ELEVENLABS_AGENT_GENERAL_HELPER=
ELEVENLABS_AGENT_SOLANA_SAGE=
ELEVENLABS_AGENT_CODE_REVIEWER=
ELEVENLABS_AGENT_TOUR_MASTER=
ELEVENLABS_AGENT_WEB_RESEARCHER=
ELEVENLABS_AGENT_MEDICAL_ADVISOR=

# Override voice IDs per broker (optional — defaults are set in lib/agent-registry.ts)
# ELEVENLABS_VOICE_GENERAL_HELPER=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_VOICE_SOLANA_SAGE=TxGEqnHWrfWFTfGW9XjX
# ELEVENLABS_VOICE_CODE_REVIEWER=ErXwobaYiN019PkySvjV
# ELEVENLABS_VOICE_TOUR_MASTER=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_VOICE_WEB_RESEARCHER=pqHfZKP75CvOlQylNhV4
# ELEVENLABS_VOICE_MEDICAL_ADVISOR=EXAVITQu4vr4xnSDxMaL

# ===============================================
# ERC-8004 Broker tokenIds (set after on-chain registration)
# Deploy contracts, call registerAgent() for each broker, then paste the tokenIds here.
# ===============================================
ERC8004_TOKEN_GENERAL_HELPER=
ERC8004_TOKEN_SOLANA_SAGE=
ERC8004_TOKEN_CODE_REVIEWER=
ERC8004_TOKEN_TOUR_MASTER=
ERC8004_TOKEN_WEB_RESEARCHER=
ERC8004_TOKEN_MEDICAL_ADVISOR=


# ===============================================
# API Topology (CORS-proof architecture)
# ===============================================
# PREFERRED (Vercel production): set API_PROXY_TARGET to the backend origin.
# The browser then calls its OWN origin at /api/* and the Next.js server
# proxies server-to-server — no browser CORS, no preflight round-trips.
# Leave UNSET on the Hetzner VPS itself and in local dev (local API routes
# handle requests there).
API_PROXY_TARGET=https://api.your-claflin-app.com

# LEGACY/direct mode (not recommended): route browser calls cross-origin.
# Works because proxy.ts answers preflights, but any backend proxy
# hiccup surfaces as a browser CORS error. Unset when using API_PROXY_TARGET.
# NEXT_PUBLIC_API_URL=https://api.your-claflin-app.com

# Optional: restrict cross-origin API access to an allowlist (comma-separated).
# Default reflects any Origin (safe: no cookies/credentials are used).
# CORS_ALLOWED_ORIGINS=https://your-claflin-app.vercel.app,http://localhost:3000

# ===============================================
# Platform Configuration
# ===============================================
# The Claflin platform address that acts as the ERC-8004 delegate.
# Users grant permissions TO this address.
NEXT_PUBLIC_PLATFORM_ADDRESS=0x54351049081A5A64Ea93c56b666830ED5076b960

# ===============================================
# Venice AI (privacy-first AI for research)
# Get your API key from: https://venice.ai
# ===============================================
VENICE_API_KEY=your_venice_api_key_here

# ===============================================
# 1Shot Permissionless Relayer (gas abstraction)
# Optional — relayer is permissionless, no key required.
# Add a key for higher rate limits.
# ===============================================
ONESHOT_RELAYER_URL=https://relayer.1shotapi.com
ONESHOT_API_KEY=

# ===============================================
# Firecrawl (OPTIONAL - for advanced web scraping)
# Get your API key from: https://firecrawl.dev
# ==============================================
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ==============================================
# Tavily (OPTIONAL - for AI-powered search)
# Get your API key from: https://tavily.com
# ===============================================
TAVILY_API_KEY=your_tavily_api_key_here
