{
  "name": "claflin",
  "version": "0.1.0",
  "private": true,
  "description": "Claflin — a curated brokerage house. Hetty’s Base desk brings live tokenized-stock estimates, explicit review, and paper trade records together.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "NODE_ENV=production next build --webpack",
    "postbuild": "NODE_ENV=production bash scripts/cleanup-standalone.sh",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@elevenlabs/react": "1.14.0",
    "@privy-io/react-auth": "3.39.0",
    "@privy-io/server-auth": "1.32.5",
    "@upstash/redis": "^1.37.0",
    "ethers": "^6.16.0",
    "lucide-react": "^0.263.1",
    "next": "16.3.4",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^3.4.19",
    "three": "0.180.0",
    "viem": "^1.19.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@types/three": "0.180.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "25.0.1",
    "postcss": "^8.5.6",
    "tsx": "^4.7.0",
    "typescript": "^5"
  }
}
