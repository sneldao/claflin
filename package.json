{
  "name": "claflin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  },
  "license": "MIT",
  "description": "Claflin — a Deco-futurist brokerage house. Specialist desks for Base (Hetty) and Solana (Jesse): voice-first paper trading, explicit review, and a record you keep.",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "postbuild": "NODE_ENV=production bash scripts/cleanup-standalone.sh",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:desk-copy": "node scripts/check-desk-copy.mjs",
    "check:canon": "node scripts/check-desk-copy.mjs",
    "check:broker-voice": "node scripts/check-broker-voice.mjs",
    "check:room-budget": "node scripts/measure-room-budget.mjs",
    "test:comprehension": "tsx --test tests/comprehension.test.ts"
  },
  "dependencies": {
    "@elevenlabs/react": "1.19.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@privy-io/react-auth": "3.51.0",
    "@privy-io/server-auth": "1.32.5",
    "@solana/web3.js": "1.98.4",
    "@upstash/redis": "^1.39.0",
    "bn.js": "5.2.5",
    "ethers": "^6.17.0",
    "lenis": "1.3.27",
    "lucide-react": "^0.263.1",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "three": "0.186.1",
    "viem": "^1.19.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bn.js": "5.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "25.0.1",
    "postcss": "^8.5.31",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
